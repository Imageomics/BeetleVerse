cff-version: 1.2.0
title: BeetleVerse
message: >
  If you use this software, please cite it using the reference below.
  This repository provides benchmarking code and evaluation notebooks.
  If you use any datasets, please cite the original datasets as specified
  in the README.
type: software
authors:
  - given-names: "S. M."
    family-names: Rayeed
  - given-names: Alyson
    family-names: East
  - given-names: Samuel
    family-names: Stevens
  - given-names: Sydne
    family-names: Record
  - given-names: "Charles V."
    family-names: Stewart
identifiers:
  - description: "The GitHub release URL of this version."
    type: url
    value: "https://github.com/Imageomics/BeetleVerse/releases/tag/v1.0"
  - description: "The GitHub URL of the commit tagged with v1.0."
    type: url
    value: "https://github.com/Imageomics/BeetleVerse/tree/<commit-hash>" # Update after release
repository-code: "https://github.com/Imageomics/BeetleVerse"
abstract: "BeetleVerse is a benchmarking suite for evaluating vision models on ground beetle classification. It provides evaluation notebooks and results for genus- and species-level classification, domain adaptation, sample-efficient probing, and multimodal extensions using existing beetle datasets. This repository accompanies the paper: BeetleVerse: A study on taxonomic classification of ground beetles."
keywords:
  - beetles
  - taxonomy
  - classification
  - vision models
  - domain adaptation
  - multimodal
  - imageomics
  - benchmarking
license: MIT
version: 1.0.0
date-released: "2026-02-XX" # This is to be updated before release to match release date
# doi: # add after release
references:
  - type: conference-workshop-paper
    title: "BeetleVerse: A study on taxonomic classification of ground beetles"
    authors:
      - given-names: "S. M."
        family-names: Rayeed
